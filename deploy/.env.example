# Copy this file to .env and fill in the values marked CHANGE ME.
# Nothing else is required to start.

# ---- image -----------------------------------------------------------------
# The tag to run. 0.1.0 is the first release.
SPICA_TAG=0.1.0

# ---- identity --------------------------------------------------------------
# The user and group that own ./config and ./state. On a normal desktop that is
# 1000:1000; check with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Your timezone, so the ledger and the logs read in your clock.
TZ=UTC

# ---- passwords (CHANGE ME) -------------------------------------------------
# Icecast's source password: the mixer publishes with it. Any long random string.
ICECAST_SOURCE_PASSWORD=CHANGE ME
# Icecast's admin password, for its own /admin pages. Also random.
ICECAST_ADMIN_PASSWORD=CHANGE ME
# The password for Spica's admin (stations, genres, settings). Also random.
SPICA_ADMIN_PASSWORD=CHANGE ME

# ---- addresses -------------------------------------------------------------
# Where Spica will live, used by Icecast for stream URLs.
SPICA_HOSTNAME=localhost
# The host ports. 8000 is the audio, 8030 the web UI.
ICECAST_PORT=8000
SPICA_PORT=8030
# Only used to fill in icecast.xml on first run.
SPICA_LOCATION=Somewhere
SPICA_ADMIN_EMAIL=admin@example.com

# ---- your music ------------------------------------------------------------
# Navidrome (or any Subsonic-compatible server). Spica reads the library through
# its API — it never mounts your music folder and never writes to it.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=CHANGE ME
NAVIDROME_PASS=CHANGE ME

# ---- optional enrichment ---------------------------------------------------
# A Last.fm API key fills in genres for artists MusicBrainz does not know.
# https://www.last.fm/api/account/create
LASTFM_KEY=
# MusicBrainz asks callers to identify themselves; put your own address here.
MB_USER_AGENT=

# ---- the DJ (optional) -----------------------------------------------------
# Any OpenAI-compatible endpoint. Without it every station still plays — it just
# walks the pool instead of picking, and there are no reasons under the songs.
# You can also set this later in the admin under Settings.
LLM_BASE=
LLM_MODEL=
LLM_KEY=
# Extra headers as name=value pairs, comma separated, for gateways that need them.
LLM_HEADERS=
