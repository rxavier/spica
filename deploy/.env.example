# Copy this file to .env and fill in the values marked CHANGE ME.
# Nothing else is required to start.

# ---- image -----------------------------------------------------------------
# The tag to run. 0.13.1 is the current release.
SPICA_TAG=0.13.1

# ---- identity --------------------------------------------------------------
# The user and group that own ./config and ./state. On a normal desktop that is
# 1000:1000; check with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Your timezone, so the ledger and the logs read in your clock.
TZ=UTC

# ---- passwords (CHANGE ME) -------------------------------------------------
# Icecast's source password: the mixer publishes with it. Any long random string.
ICECAST_SOURCE_PASSWORD=CHANGE ME
# Icecast's admin password, for its own /admin pages. Also random.
ICECAST_ADMIN_PASSWORD=CHANGE ME
# The password for Spica's admin (stations, genres, settings). Also random.
SPICA_ADMIN_PASSWORD=CHANGE ME

# ---- addresses -------------------------------------------------------------
# Where Spica will live, used by Icecast for stream URLs.
SPICA_HOSTNAME=localhost
# The host ports. 8000 is the audio, 8030 the web UI.
ICECAST_PORT=8000
SPICA_PORT=8030
# Only used to fill in icecast.xml on first run.
SPICA_LOCATION=Somewhere
SPICA_ADMIN_EMAIL=admin@example.com

# ---- your music ------------------------------------------------------------
# Navidrome (or any Subsonic-compatible server). Spica reads the library through
# its API — it never mounts your music folder and never writes to it.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=CHANGE ME
NAVIDROME_PASS=CHANGE ME

# ---- optional enrichment ---------------------------------------------------
# A Last.fm API key fills in genres for artists MusicBrainz does not know.
# https://www.last.fm/api/account/create
LASTFM_KEY=
# MusicBrainz asks callers to identify themselves; put your own address here.
MB_USER_AGENT=

# ---- audio analysis (optional) ---------------------------------------------
# Off by default. `1` makes the worker listen to each track once and store what it
# sounds like (embedding, styles, moods, tempo, key, loudness), which the DJ reads
# in its tool results and in the table rows. Needs ~0.5 GB per worker process; raise
# the worker's mem_limit in compose.yaml if you raise SPICA_ANALYSIS_WORKERS.
SPICA_ANALYSIS=
# The worker needs the -analysis image:
#   docker compose -f compose.yaml -f compose.analysis.yaml up -d
# "degara" is fast; "multifeature" is more accurate and about three times the CPU.
SPICA_ANALYSIS_TEMPO=degara
# Tracks per job slice, so popularity and MusicBrainz jobs interleave with the backfill.
SPICA_ANALYSIS_SLICE=200
# Processes for one analysis job. 0 means min(2, cpu count); each needs ~0.5 GB.
SPICA_ANALYSIS_WORKERS=0
# Mel patches per inference. Leave at 32: raising it to a whole track is the same
# speed and about three times the memory.
SPICA_ANALYSIS_BATCH=32
# ONNX threads per analysis process (the net is the only part that scales with them).
SPICA_ANALYSIS_THREADS=2
# Analyse at most this many seconds per track; 0 for the whole file.
SPICA_ANALYSIS_MAX_SECONDS=240
# Compute the extra DSP nothing reads yet (loudness, classic danceability, dynamic
# complexity). Costs about a quarter of the pass; the DJ's energy comes from heads.
SPICA_ANALYSIS_DEEP=
# Read the original file by default (right choice when Navidrome is local). Set to 1
# to stream a 96 kbit/s transcode instead, when bandwidth matters more than CPU.
SPICA_ANALYSIS_TRANSCODE=0
SPICA_ANALYSIS_BITRATE=96

# ---- the DJ (optional) -----------------------------------------------------
# Any OpenAI-compatible endpoint. Without it every station still plays — it just
# walks the pool instead of picking, and there are no reasons under the songs.
# You can also set this later in the admin under Settings.
LLM_BASE=
LLM_MODEL=
LLM_KEY=
# Extra headers as name=value pairs, comma separated, for gateways that need them.
LLM_HEADERS=
